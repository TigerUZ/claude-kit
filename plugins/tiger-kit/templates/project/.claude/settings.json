{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm dev*)",
      "Bash(pnpm db:*)",
      "Bash(pnpm e2e*)",
      "Bash(supabase start*)",
      "Bash(supabase stop*)",
      "Bash(supabase migration list*)",
      "Bash(supabase db diff*)"
    ],
    "ask": [
      "Bash(supabase db push*)",
      "Bash(supabase db reset*)",
      "Bash(vercel *--prod*)",
      "Bash(eas build*)",
      "Bash(eas submit*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/typecheck-gate.sh\"",
            "timeout": 180
          }
        ]
      }
    ]
  }
}
